    "views/laboratory.html": "<div class=\"lab-shell\">\n  <div class=\"lab-mark\">API v2</div>\n  <h1>Orphira API Laboratory</h1>\n  <p>This is a sandboxed custom plugin view.</p>\n\n  <div class=\"lab-grid\">\n    <div class=\"lab-card\">\n      <strong>Sandbox</strong>\n      <span>This page is isolated from the Orphira DOM.</span>\n    </div>\n\n    <div class=\"lab-card\">\n      <strong>Smart Session</strong>\n      <span>Use the ⚗ button in the bottom player.</span>\n    </div>\n\n    <div class=\"lab-card\">\n      <strong>Diagnostics</strong>\n      <span>Use the ✓ button to run the API integration suite.</span>\n    </div>\n\n    <div class=\"lab-card\">\n      <strong>Equalizer</strong>\n      <span>Look for Laboratory Neon Line and Quantum Dots.</span>\n    </div>\n\n    <div class=\"lab-card\">\n      <strong>Context Menu</strong>\n      <span>Right-click any track to find API Lab actions.</span>\n    </div>\n\n    <div class=\"lab-card\">\n      <strong>Theme</strong>\n      <span>Select API Laboratory Neon from Appearance settings.</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .lab-shell {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: 26px;\n  }\n\n  .lab-mark {\n    display: inline-block;\n    padding: 5px 10px;\n    border-radius: 999px;\n    background: rgba(0, 229, 255, 0.12);\n    border: 1px solid rgba(0, 229, 255, 0.24);\n    color: #67e8f9;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 1px;\n  }\n\n  h1 {\n    margin: 14px 0 8px;\n    font-size: 28px;\n  }\n\n  p {\n    margin: 0 0 22px;\n    color: #94a3b8;\n  }\n\n  .lab-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .lab-card {\n    display: flex;\n    flex-direction: column;\n    gap: 7px;\n    padding: 18px;\n    border-radius: 14px;\n    background: rgba(255, 255, 255, 0.04);\n    border: 1px solid rgba(255, 255, 255, 0.09);\n  }\n\n  .lab-card strong {\n    color: #ffffff;\n    font-size: 14px;\n  }\n\n  .lab-card span {\n    color: #94a3b8;\n    font-size: 12px;\n    line-height: 1.5;\n  }\n</style>"
