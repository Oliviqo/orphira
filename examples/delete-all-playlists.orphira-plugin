{
  "manifest": {
    "$schema": "../../plugin-manifest.schema.json",
    "manifestVersion": 1,
    "id": "app.orphira.tools.delete-all-playlists",
    "name": "Delete All Playlists",
    "version": "1.0.0",
    "description": "Deletes all Orphira playlists once when enabled.",
    "author": "Orphira",
    "license": "MIT",
    "orphira": {
      "apiVersion": 2,
      "minimumVersion": "1.2.6"
    },
    "entry": "plugin.js",
    "permissions": [
      "playlists:read",
      "playlists:write",
      "ui:notifications"
    ],
    "network": {
      "hosts": []
    },
    "contributes": {
      "commands": [],
      "themes": [],
      "locales": [],
      "views": []
    }
  },
  "files": {
    "plugin.js": "module.exports = {\r\n async activate(api) {\r\n const playlists =\r\n await api.playlists.get();\r\n\r\n let deleted = 0;\r\n\r\n for (\r\n const playlist\r\n of playlists\r\n ) {\r\n const removed =\r\n await api.playlists.remove(\r\n playlist.id\r\n );\r\n\r\n if (removed) {\r\n deleted++;\r\n }\r\n }\r\n\r\n await api.notifications.show(\r\n `Deleted ${deleted} playlists`,\r\n 'success'\r\n );\r\n },\r\n\r\n async deactivate() {\r\n }\r\n};"
  }
}